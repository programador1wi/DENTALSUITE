generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationStatus {
  ACTIVE
  INACTIVE
}

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
  PENDING
}

enum BranchStatus {
  ACTIVE
  INACTIVE
}

enum PaymentMethodType {
  CASH
  CARD
  TRANSFER
  DEPOSIT
  ONLINE
  CREDIT
  OTHER
}

enum CurrencyCode {
  MXN
  USD
  EUR
}

enum PatientStatus {
  NEW
  ACTIVE
  IN_TREATMENT
  INACTIVE
  DEBTOR
  COMPLETED
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  PENDING_CONFIRMATION
  ARRIVED
  WAITING_ROOM
  IN_PROGRESS
  COMPLETED
  CANCELLED_BY_PATIENT
  CANCELLED_BY_CLINIC
  NO_SHOW
  RESCHEDULED
  BLOCKED
}

enum ToothProcedureStatus {
  PLANNED
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PeriodontalPosition {
  MB
  B
  DB
  ML
  L
  DL
}

enum TreatmentPlanStatus {
  DRAFT
  PRESENTED
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  REJECTED
}

enum TreatmentPlanItemStatus {
  PLANNED
  ACCEPTED
  PAID
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum BudgetStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

enum PaymentStatus {
  RECEIVED
  PARTIALLY_ALLOCATED
  ALLOCATED
  REFUNDED
  VOIDED
}

enum PaymentLinkStatus {
  CREATED
  PAID
  EXPIRED
  CANCELLED
}

enum InstallmentFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum InstallmentPlanStatus {
  DRAFT
  ACTIVE
  COMPLETED
  DEFAULTED
  CANCELLED
}

enum InstallmentStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
}

enum CashRegisterStatus {
  OPEN
  CLOSED
}

enum CashMovementType {
  OPENING
  INCOME
  EXPENSE
  ADJUSTMENT
  REFUND
  CLOSING
}

enum RefundStatus {
  PENDING
  PROCESSED
  CANCELLED
}

enum CollectionCaseStatus {
  PENDING
  CONTACTED
  PROMISE_TO_PAY
  PAID
  UNCOLLECTIBLE
  CANCELLED
}

enum ConsentStatus {
  DRAFT
  SIGNED
  CANCELLED
}

enum LabOrderStatus {
  REQUESTED
  SENT
  IN_PROCESS
  RECEIVED
  DELIVERED
  CANCELLED
}

enum InventoryMovementType {
  IN
  OUT
  ADJUSTMENT
}

model Organization {
  id                        String                     @id @default(cuid())
  name                      String
  legalName                 String?
  taxId                     String?
  phone                     String?
  email                     String?
  address                   String?
  logoUrl                   String?
  isActive                  Boolean                    @default(true)
  slug                      String?                    @unique
  status                    OrganizationStatus         @default(ACTIVE)
  branches                  Branch[]
  users                     User[]
  roles                     Role[]
  professionals             Professional[]
  patients                  Patient[]
  appointments              Appointment[]
  specialties               Specialty[]
  clinicalDocumentTemplates ClinicalDocumentTemplate[]
  chairs                    Chair[]
  paymentMethods            PaymentMethod[]
  financialInstitutions     FinancialInstitution[]
  procedureCategories       ProcedureCategory[]
  procedures                Procedure[]
  priceLists                PriceList[]
  agreements                Agreement[]
  expenseCategories         ExpenseCategory[]
  expenses                  Expense[]
  payrollLiquidations       PayrollLiquidation[]
  treatmentPlans            TreatmentPlan[]
  budgets                   Budget[]
  payments                  Payment[]
  paymentLinks              PaymentLink[]
  installmentPlans          InstallmentPlan[]
  cashRegisters             CashRegister[]
  refunds                   Refund[]
  fileAttachments           FileAttachment[]
  consentTemplates          ConsentTemplate[]
  labProviders              LabProvider[]
  labOrders                 LabOrder[]
  inventoryItems            InventoryItem[]
  suppliers                 Supplier[]
  auditLogs                 AuditLog[]
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  deletedAt                 DateTime?

  @@index([isActive])
  @@index([status])
}

model Branch {
  id                    String                 @id @default(cuid())
  organizationId        String
  organization          Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                  String
  phone                 String?
  email                 String?
  address               String?
  city                  String?
  state                 String?
  country               String?                @default("MX")
  timezone              String?                @default("America/Mexico_City")
  isActive              Boolean                @default(true)
  code                  String?
  status                BranchStatus           @default(ACTIVE)
  users                 UserBranch[]
  professionalBranches  ProfessionalBranch[]
  professionalSchedules ProfessionalSchedule[]
  chairs                Chair[]
  treatmentPlans        TreatmentPlan[]
  payments              Payment[]
  expenses              Expense[]
  payrollLiquidations   PayrollLiquidation[]
  cashRegisters         CashRegister[]
  refunds               Refund[]
  inventoryItems        InventoryItem[]
  inventoryMovements    InventoryMovement[]
  patients              Patient[]
  appointments          Appointment[]
  auditLogs             AuditLog[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  deletedAt             DateTime?
  createdById           String?
  updatedById           String?

  @@unique([organizationId, code])
  @@index([organizationId, isActive])
  @@index([organizationId, status])
}

model User {
  id                        String                     @id @default(cuid())
  organizationId            String
  organization              Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  firstName                 String
  lastName                  String
  email                     String                     @unique
  phone                     String?
  passwordHash              String
  avatarUrl                 String?
  isActive                  Boolean                    @default(true)
  lastLoginAt               DateTime?
  status                    UserStatus                 @default(ACTIVE)
  roleId                    String?
  role                      Role?                      @relation("PrimaryUserRole", fields: [roleId], references: [id])
  roles                     UserRole[]
  branches                  UserBranch[]
  sessions                  Session[]
  professional              Professional?
  patientNotes              PatientNote[]
  appointmentsCreated       Appointment[]              @relation("AppointmentCreatedBy")
  appointmentsUpdated       Appointment[]              @relation("AppointmentUpdatedBy")
  appointmentStatusChanges  AppointmentStatusHistory[] @relation("AppointmentStatusChangedBy")
  appointmentNotes          AppointmentNote[]
  signedClinicalEvolutions  ClinicalEvolution[]        @relation("ClinicalEvolutionSignedBy")
  clinicalDocumentsCreated  ClinicalDocument[]         @relation("ClinicalDocumentCreatedBy")
  paymentsReceived          Payment[]                  @relation("PaymentReceivedBy")
  cashRegistersOpened       CashRegister[]             @relation("CashRegisterOpenedBy")
  cashRegistersClosed       CashRegister[]             @relation("CashRegisterClosedBy")
  cashMovementsCreated      CashMovement[]             @relation("CashMovementCreatedBy")
  expensesCreated           Expense[]                  @relation("ExpenseCreatedBy")
  refundsProcessed          Refund[]                   @relation("RefundProcessedBy")
  assignedCollectionCases   CollectionCase[]           @relation("CollectionCaseAssignedTo")
  collectionActivities      CollectionActivity[]
  uploadedFiles             FileAttachment[]           @relation("FileAttachmentUploadedBy")
  inventoryMovementsCreated InventoryMovement[]        @relation("InventoryMovementCreatedBy")
  payrollLiquidationsFinalized PayrollLiquidation[]
  auditLogs                 AuditLog[]                 @relation("AuditLogUser")
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  deletedAt                 DateTime?
  createdById               String?
  updatedById               String?

  @@index([organizationId, isActive])
  @@index([organizationId, status])
  @@index([roleId])
}

model Role {
  id             String           @id @default(cuid())
  organizationId String?
  organization   Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  isSystem       Boolean          @default(false)
  code           String?
  isActive       Boolean          @default(true)
  permissions    RolePermission[]
  users          User[]           @relation("PrimaryUserRole")
  userRoles      UserRole[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?
  createdById    String?
  updatedById    String?

  @@unique([organizationId, name])
  @@unique([organizationId, code])
  @@index([organizationId, isActive])
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  name        String
  description String?
  module      String
  code        String?          @unique
  action      String?
  resource    String?
  isSystem    Boolean          @default(true)
  isActive    Boolean          @default(true)
  roles       RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?

  @@index([module])
  @@index([isActive])
}

model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@id([roleId, permissionId])
}

model UserBranch {
  userId    String
  branchId  String
  isPrimary Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, branchId])
  @@index([branchId])
}

model Professional {
  id                 String                  @id @default(cuid())
  organizationId     String
  organization       Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId             String?                 @unique
  user               User?                   @relation(fields: [userId], references: [id], onDelete: SetNull)
  firstName          String
  lastName           String
  licenseNumber      String?
  phone              String?
  email              String?
  color              String?
  isActive           Boolean                 @default(true)
  specialties        ProfessionalSpecialty[]
  branches           ProfessionalBranch[]
  schedules          ProfessionalSchedule[]
  appointments       Appointment[]
  treatmentPlans     TreatmentPlan[]
  budgets            Budget[]
  clinicalEvolutions ClinicalEvolution[]
  prescriptions      Prescription[]
  odontogramRecords  OdontogramRecord[]
  toothProcedures    ToothProcedure[]
  periodontalCharts  PeriodontalChart[]
  labOrders          LabOrder[]
  payrollLiquidations PayrollLiquidation[]
  commissionRate     Decimal                 @default(0) @db.Decimal(5, 2)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  @@unique([organizationId, email])
  @@index([organizationId, isActive])
}

model PayrollLiquidation {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  professionalId  String
  professional    Professional @relation(fields: [professionalId], references: [id], onDelete: Restrict)
  branchId        String?
  branch          Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  commissionRate  Decimal      @db.Decimal(5, 2)
  completedItems  Int
  collectedAmount Decimal      @db.Decimal(10, 2)
  payableAmount   Decimal      @db.Decimal(10, 2)
  lastCompletedAt DateTime?
  items           PayrollLiquidationItem[]
  finalizedAt     DateTime     @default(now())
  finalizedById   String
  finalizedBy     User         @relation(fields: [finalizedById], references: [id], onDelete: Restrict)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([organizationId, finalizedAt])
  @@index([professionalId, finalizedAt])
  @@index([branchId, finalizedAt])
}

model PayrollLiquidationItem {
  id                  String              @id @default(cuid())
  liquidationId       String
  liquidation         PayrollLiquidation  @relation(fields: [liquidationId], references: [id], onDelete: Cascade)
  treatmentPlanItemId String              @unique
  treatmentPlanItem   TreatmentPlanItem   @relation(fields: [treatmentPlanItemId], references: [id], onDelete: Restrict)
  collectedAmount     Decimal             @db.Decimal(10, 2)
  payableAmount       Decimal             @db.Decimal(10, 2)
  createdAt           DateTime            @default(now())

  @@index([liquidationId])
}

model Specialty {
  id                 String                      @id @default(cuid())
  organizationId     String
  organization       Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name               String
  description        String?
  isActive           Boolean                     @default(true)
  professionals      ProfessionalSpecialty[]
  appointments       Appointment[]
  clinicalTemplates  SpecialtyClinicalTemplate[]
  appointmentReasons SpecialtyAppointmentReason[]
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId, isActive])
}

enum SpecialtyClinicalTemplateType {
  PRESCRIPTION
  EVOLUTION
}

model SpecialtyClinicalTemplate {
  id          String                        @id @default(cuid())
  specialtyId String
  specialty   Specialty                     @relation(fields: [specialtyId], references: [id], onDelete: Cascade)
  type        SpecialtyClinicalTemplateType
  name        String
  content     String
  isActive    Boolean                       @default(true)
  createdAt   DateTime                      @default(now())
  updatedAt   DateTime                      @updatedAt

  @@unique([specialtyId, type, name])
  @@index([specialtyId, type, isActive])
}

model SpecialtyAppointmentReason {
  id              String    @id @default(cuid())
  specialtyId     String
  specialty       Specialty @relation(fields: [specialtyId], references: [id], onDelete: Cascade)
  name            String
  durationMinutes Int
  color           String?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([specialtyId, name])
  @@index([specialtyId, isActive])
}

model ProfessionalSpecialty {
  professionalId String
  specialtyId    String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  specialty      Specialty    @relation(fields: [specialtyId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@id([professionalId, specialtyId])
  @@index([specialtyId])
}

model ProfessionalBranch {
  professionalId String
  branchId       String
  isPrimary      Boolean      @default(false)
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  branch         Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@id([professionalId, branchId])
  @@index([branchId])
}

model ProfessionalSchedule {
  id             String       @id @default(cuid())
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  branchId       String
  branch         Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  dayOfWeek      Int
  startTime      String
  endTime        String
  breakStartTime String?
  breakEndTime   String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([professionalId, branchId, dayOfWeek, isActive])
}

model Chair {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId       String
  branch         Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  isActive       Boolean       @default(true)
  appointments   Appointment[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([branchId, name])
  @@index([organizationId, isActive])
}

model PaymentMethod {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  type           PaymentMethodType
  isActive       Boolean           @default(true)
  payments       Payment[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId, isActive])
}

model FinancialInstitution {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  isActive       Boolean      @default(true)
  payments       Payment[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId, isActive])
}

model ProcedureCategory {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  sortOrder      Int          @default(0)
  procedures     Procedure[]
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId, sortOrder])
}

model Procedure {
  id                 String              @id @default(cuid())
  organizationId     String
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  categoryId         String
  category           ProcedureCategory   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  code               String
  name               String
  description        String?
  defaultDuration    Int                 @default(30)
  requiresTooth      Boolean             @default(false)
  requiresSurface    Boolean             @default(false)
  requiresLab        Boolean             @default(false)
  isActive           Boolean             @default(true)
  priceListItems     PriceListItem[]
  odontogramRecords  OdontogramRecord[]
  toothProcedures    ToothProcedure[]
  treatmentPlanItems TreatmentPlanItem[]
  consentTemplates   ConsentTemplate[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([organizationId, code])
  @@index([organizationId, isActive])
}

model PriceList {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  isDefault      Boolean         @default(false)
  isActive       Boolean         @default(true)
  items          PriceListItem[]
  agreements     Agreement[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId, isDefault])
}

model Agreement {
  id                       String       @id @default(cuid())
  organizationId           String
  organization             Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                     String
  description              String?
  priceListId              String?
  priceList                PriceList?   @relation(fields: [priceListId], references: [id], onDelete: SetNull)
  discountPercent          Decimal      @default(0) @db.Decimal(5, 2)
  appliesToLabs            Boolean      @default(false)
  appliesToOtherCategories Boolean      @default(false)
  payrollDiscount          Boolean      @default(false)
  isPublic                 Boolean      @default(true)
  isActive                 Boolean      @default(true)
  patients                 Patient[]
  treatmentPlanItems       TreatmentPlanItem[]
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId, isActive])
  @@index([priceListId])
}

model ExpenseCategory {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  isActive       Boolean      @default(true)
  expenses       Expense[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId, isActive])
}

model Expense {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId       String
  branch         Branch          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  categoryId     String
  category       ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  description    String
  quantity       Decimal         @default(1) @db.Decimal(10, 2)
  unitCost       Decimal         @db.Decimal(10, 2)
  total          Decimal         @db.Decimal(10, 2)
  invoicedAt     DateTime?
  paidAt         DateTime
  notes          String?
  cashMovements  CashMovement[]
  createdById    String
  createdBy      User            @relation("ExpenseCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([organizationId, paidAt])
  @@index([branchId, paidAt])
  @@index([categoryId, paidAt])
}

model PriceListItem {
  id          String       @id @default(cuid())
  priceListId String
  priceList   PriceList    @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  procedureId String
  procedure   Procedure    @relation(fields: [procedureId], references: [id], onDelete: Restrict)
  price       Decimal      @db.Decimal(10, 2)
  currency    CurrencyCode @default(MXN)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([priceListId, procedureId])
}

model Patient {
  id                 String                @id @default(cuid())
  organizationId     String
  organization       Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId           String
  branch             Branch                @relation(fields: [branchId], references: [id], onDelete: Restrict)
  agreementId        String?
  agreement          Agreement?            @relation(fields: [agreementId], references: [id], onDelete: SetNull)
  firstName          String
  lastName           String
  birthDate          DateTime?
  gender             String?
  documentType       String?
  documentNumber     String?
  email              String?
  phone              String?
  alternatePhone     String?
  occupation         String?
  referredBy         String?
  source             String?
  status             PatientStatus         @default(ACTIVE)
  contacts           PatientContact[]
  address            PatientAddress?
  medicalAlerts      PatientMedicalAlert[]
  notes              PatientNote[]
  appointments       Appointment[]
  medicalHistory     MedicalHistory?
  medicalConditions  MedicalCondition[]
  allergies          Allergy[]
  medications        Medication[]
  clinicalEvolutions ClinicalEvolution[]
  prescriptions      Prescription[]
  clinicalDocuments  ClinicalDocument[]
  odontogramRecords  OdontogramRecord[]
  toothConditions    ToothCondition[]
  toothProcedures    ToothProcedure[]
  periodontalCharts  PeriodontalChart[]
  treatmentPlans     TreatmentPlan[]
  budgets            Budget[]
  payments           Payment[]
  paymentLinks       PaymentLink[]
  installmentPlans   InstallmentPlan[]
  installments       Installment[]
  refunds            Refund[]
  collectionCases    CollectionCase[]
  fileAttachments    FileAttachment[]
  consents           Consent[]
  labOrders          LabOrder[]
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  deletedAt          DateTime?

  @@index([organizationId, branchId, status])
  @@index([organizationId, phone])
  @@index([organizationId, email])
  @@index([organizationId, documentNumber])
  @@index([agreementId])
  @@index([createdAt])
}

model PatientContact {
  id                 String   @id @default(cuid())
  patientId          String
  patient            Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  name               String
  relationship       String?
  phone              String?
  email              String?
  isEmergencyContact Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([patientId, isEmergencyContact])
}

model PatientAddress {
  id        String   @id @default(cuid())
  patientId String   @unique
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  street    String?
  city      String?
  state     String?
  country   String?
  zipCode   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PatientMedicalAlert {
  id          String   @id @default(cuid())
  patientId   String
  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  type        String
  description String
  severity    String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([patientId, isActive])
  @@index([severity])
}

model PatientNote {
  id        String   @id @default(cuid())
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  note      String
  isPrivate Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([patientId, createdAt])
  @@index([userId, createdAt])
}

model Appointment {
  id                 String                     @id @default(cuid())
  organizationId     String
  organization       Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId           String
