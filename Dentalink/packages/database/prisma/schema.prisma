  @@unique([organizationId, name])
  @@index([organizationId, isActive])
}

model LabOrder {
  id              String         @id @default(cuid())
  organizationId  String
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patientId       String
  patient         Patient        @relation(fields: [patientId], references: [id], onDelete: Restrict)
  treatmentPlanId String?
  treatmentPlan   TreatmentPlan? @relation(fields: [treatmentPlanId], references: [id], onDelete: SetNull)
  professionalId  String
  professional    Professional   @relation(fields: [professionalId], references: [id], onDelete: Restrict)
  labProviderId   String
  labProvider     LabProvider    @relation(fields: [labProviderId], references: [id], onDelete: Restrict)
  status          LabOrderStatus @default(REQUESTED)
  sentAt          DateTime?
  expectedAt      DateTime?
  receivedAt      DateTime?
  cost            Decimal?       @db.Decimal(10, 2)
  notes           String?
  items           LabOrderItem[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([organizationId, status, createdAt])
  @@index([patientId, createdAt])
  @@index([treatmentPlanId])
  @@index([labProviderId, status])
}

model LabOrderItem {
  id          String   @id @default(cuid())
  labOrderId  String
  labOrder    LabOrder @relation(fields: [labOrderId], references: [id], onDelete: Cascade)
  description String
  quantity    Decimal  @default(1) @db.Decimal(10, 2)
  unitCost    Decimal? @db.Decimal(10, 2)
  toothNumber String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([labOrderId])
}

model Supplier {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  phone          String?
  email          String?
  address        String?
  isActive       Boolean         @default(true)
  inventoryItems InventoryItem[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId, isActive])
}

model InventoryItem {
  id             String              @id @default(cuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  sku            String
  category       String
  unit           String
  stock          Decimal             @default(0) @db.Decimal(12, 2)
  minStock       Decimal             @default(0) @db.Decimal(12, 2)
  branchId       String
  branch         Branch              @relation(fields: [branchId], references: [id], onDelete: Restrict)
  supplierId     String?
  supplier       Supplier?           @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  isActive       Boolean             @default(true)
  movements      InventoryMovement[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([organizationId, sku, branchId])
  @@index([organizationId, branchId, isActive])
  @@index([organizationId, category])
}

model InventoryMovement {
  id              String                @id @default(cuid())
  inventoryItemId String
  inventoryItem   InventoryItem         @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  branchId        String
  branch          Branch                @relation(fields: [branchId], references: [id], onDelete: Restrict)
  type            InventoryMovementType
  quantity        Decimal               @db.Decimal(12, 2)
  reason          String?
  createdById     String
  createdBy       User                  @relation("InventoryMovementCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt       DateTime              @default(now())

  @@index([inventoryItemId, createdAt])
  @@index([branchId, createdAt])
  @@index([type, createdAt])
}

model FileAttachment {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patientId      String?
  patient        Patient?     @relation(fields: [patientId], references: [id], onDelete: SetNull)
  uploadedById   String
  uploadedBy     User         @relation("FileAttachmentUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)
  fileName       String
  originalName   String
  mimeType       String
  size           Int
  url            String
  category       String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, category, createdAt])
  @@index([patientId, createdAt])
}

model ConsentTemplate {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  content        String
  procedureId    String?
  procedure      Procedure?   @relation(fields: [procedureId], references: [id], onDelete: SetNull)
  isActive       Boolean      @default(true)
  consents       Consent[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId, isActive])
}

model Consent {
  id              String              @id @default(cuid())
  patientId       String
  patient         Patient             @relation(fields: [patientId], references: [id], onDelete: Restrict)
  templateId      String
  template        ConsentTemplate     @relation(fields: [templateId], references: [id], onDelete: Restrict)
  treatmentPlanId String?
  treatmentPlan   TreatmentPlan?      @relation(fields: [treatmentPlanId], references: [id], onDelete: SetNull)
  appointmentId   String?
  appointment     Appointment?        @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  contentSnapshot String
  status          ConsentStatus       @default(DRAFT)
  signedAt        DateTime?
  signatures      DocumentSignature[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([patientId, status, createdAt])
  @@index([templateId, createdAt])
  @@index([treatmentPlanId])
  @@index([appointmentId])
}

model DocumentSignature {
  id            String   @id @default(cuid())
  consentId     String
  consent       Consent  @relation(fields: [consentId], references: [id], onDelete: Cascade)
  signerName    String
  signerType    String
  signatureData String
  ipAddress     String?
  signedAt      DateTime @default(now())

  @@index([consentId, signedAt])
}

model AppointmentStatusHistory {
  id             String             @id @default(cuid())
  appointmentId  String
  appointment    Appointment        @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  previousStatus AppointmentStatus?
  newStatus      AppointmentStatus
  changedById    String
  changedBy      User               @relation("AppointmentStatusChangedBy", fields: [changedById], references: [id], onDelete: Restrict)
  reason         String?
  createdAt      DateTime           @default(now())

  @@index([appointmentId, createdAt])
  @@index([changedById, createdAt])
}

model AppointmentNote {
  id            String      @id @default(cuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  note          String
  isPrivate     Boolean     @default(false)
  createdAt     DateTime    @default(now())

  @@index([appointmentId, createdAt])
}

model AppointmentReminder {
  id            String      @id @default(cuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  channel       String
  scheduledAt   DateTime
  sentAt        DateTime?
  status        String      @default("PENDING")
  errorMessage  String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([appointmentId, scheduledAt])
  @@index([status, scheduledAt])
}

model Session {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model AuditLog {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  branchId       String?
  branch         Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  userId         String?
  user           User?         @relation("AuditLogUser", fields: [userId], references: [id], onDelete: SetNull)
  action         String
  entity         String
  entityId       String?
  oldValue       Json?
  newValue       Json?
  ipAddress      String?
  userAgent      String?
  actorUserId    String?
  before         Json?
  after          Json?
  createdAt      DateTime      @default(now())

  @@index([organizationId, entity])
  @@index([userId])
  @@index([createdAt])
}
