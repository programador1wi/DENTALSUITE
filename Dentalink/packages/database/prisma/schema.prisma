  agreement             Agreement?                         @relation(fields: [agreementId], references: [id], onDelete: SetNull)
  planName              String?
  policyNumber          String?
  affiliateNumber       String?
  certificateNumber     String?
  employeeNumber        String?
  holderName            String?
  holderDocument        String?
  relationshipToPatient String?
  startsAt              DateTime?
  endsAt                DateTime?
  coveragePercent       Decimal?                           @db.Decimal(5, 2)
  copayAmount           Decimal?                           @db.Decimal(10, 2)
  deductibleAmount      Decimal?                           @db.Decimal(10, 2)
  annualLimitAmount     Decimal?                           @db.Decimal(10, 2)
  requiresAuthorization Boolean                            @default(false)
  notes                 String?
  externalReference     String?
  lastValidatedAt       DateTime?
  lastValidationStatus  PatientBenefitCoverageStatus?
  lastValidationSummary String?
  metadata              Json?
  createdById           String?
  updatedById           String?
  version               Int                                @default(1)
  validations           PatientBenefitCoverageValidation[]
  audits                PatientBenefitCoverageAudit[]
  documents             PatientBenefitCoverageDocument[]
  coverageCases         CoverageCase[]
  createdAt             DateTime                           @default(now())
  updatedAt             DateTime                           @updatedAt

  @@index([organizationId, patientId, status])
  @@index([branchId, status])
  @@index([agreementId])
  @@index([policyNumber])
  @@index([affiliateNumber])
  @@index([endsAt])
}

model PatientBenefitCoverageValidation {
  id                 String                       @id @default(cuid())
  coverageId         String
  coverage           PatientBenefitCoverage       @relation(fields: [coverageId], references: [id], onDelete: Cascade)
  organizationId     String
  organization       Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId           String
  branch             Branch                       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  patientId          String
  patient            Patient                      @relation(fields: [patientId], references: [id], onDelete: Restrict)
  mode               CoverageValidationMode       @default(MANUAL)
  status             PatientBenefitCoverageStatus @default(PENDING_VALIDATION)
  providerName       String?
  externalIdentifier String?
  requestSnapshot    Json?
  responseSnapshot   Json?
  normalizedResult   Json?
  errorMessage       String?
  retryCount         Int                          @default(0)
  validatedAt        DateTime?
  createdById        String?
  createdAt          DateTime                     @default(now())

  @@index([coverageId, createdAt])
  @@index([organizationId, patientId, createdAt])
}

model PatientBenefitCoverageDocument {
  id               String                 @id @default(cuid())
  coverageId       String
  coverage         PatientBenefitCoverage @relation(fields: [coverageId], references: [id], onDelete: Cascade)
  organizationId   String
  organization     Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId         String
  branch           Branch                 @relation(fields: [branchId], references: [id], onDelete: Restrict)
  patientId        String
  patient          Patient                @relation(fields: [patientId], references: [id], onDelete: Restrict)
  fileAttachmentId String
  fileAttachment   FileAttachment         @relation(fields: [fileAttachmentId], references: [id], onDelete: Restrict)
  category         String
  notes            String?
  uploadedById     String?
  createdAt        DateTime               @default(now())

  @@index([coverageId, createdAt])
  @@index([fileAttachmentId])
  @@index([organizationId, patientId])
}

model PatientBenefitCoverageAudit {
  id             String                 @id @default(cuid())
  coverageId     String
  coverage       PatientBenefitCoverage @relation(fields: [coverageId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId       String
  branch         Branch                 @relation(fields: [branchId], references: [id], onDelete: Restrict)
  patientId      String
  patient        Patient                @relation(fields: [patientId], references: [id], onDelete: Restrict)
  action         String
  before         Json?
  after          Json?
  reason         String?
  correlationId  String?
  actorUserId    String?
  createdAt      DateTime               @default(now())

  @@index([coverageId, createdAt])
  @@index([organizationId, patientId, createdAt])
  @@index([actorUserId])
}

enum OrthodonticProgressStatus {
  DELAYED
  ON_TRACK
  AHEAD
  NOT_CALCULABLE
}

model OrthodonticProgressSnapshot {
  id                     String                    @id @default(cuid())
  treatmentId            String
  treatment              TreatmentPlan             @relation(fields: [treatmentId], references: [id], onDelete: Cascade)
  cutoffDate             DateTime
  calculatedAt           DateTime
  plannedControls        Int?
  expectedControls       Int?
  completedControls      Int
  calendarProgress       Decimal?                  @db.Decimal(10, 2)
  realProgress           Decimal?                  @db.Decimal(10, 2)
  progressDifference     Decimal?                  @db.Decimal(10, 2)
  progressStatus         OrthodonticProgressStatus @default(NOT_CALCULABLE)
  hasFutureAppointment   Boolean                   @default(false)
  lastEvolutionAt        DateTime?
  suggestedAppointmentAt DateTime?
  scheduledAppointmentAt DateTime?
  calculationVersion     String

  @@index([treatmentId, cutoffDate])
}
