{
  "name": "dentalwarner-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Enterprise dental ERP/CRM platform for multi-branch clinics.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "dev:detached": "node scripts/dev.cjs --detached",
    "dev:api": "npm run start:dev --workspace=@dentalwarner/api",
    "dev:web": "npm run dev --workspace=@dentalwarner/web",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md,yml,yaml,prisma}\"",
    "test": "npm run test --workspaces --if-present",
    "db:up": "docker compose up -d postgres redis",
    "db:down": "docker compose down",
    "db:generate": "node scripts/db-generate.cjs",
    "db:migrate": "node scripts/db-migrate.cjs",
    "db:migrate:status": "node scripts/db-migrate-status.cjs",
    "db:seed": "node scripts/db-seed.cjs",
    "db:seed:demo": "node scripts/db-seed-demo.cjs",
    "db:studio": "node scripts/db-studio.cjs",
    "db:backup": "node scripts/db-backup.cjs",
    "db:index:check": "node scripts/db-index-check.cjs",
    "prisma:generate": "npm run prisma:generate --workspace=@dentalwarner/database",
    "prisma:migrate": "npm run prisma:migrate --workspace=@dentalwarner/database",
    "prisma:seed": "npm run prisma:seed --workspace=@dentalwarner/database"
  },
  "devDependencies": {
    "@dentalwarner/config": "file:packages/config",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.4.0",
    "prettier": "^3.8.3",
    "typescript-eslint": "^8.59.4"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  }
}
