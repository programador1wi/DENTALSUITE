DATABASE_URL="postgresql://dentalwarner_app:dentalwarner_app_local@localhost:55432/dentalwarner?schema=public"
MIGRATION_DATABASE_URL="postgresql://dentalwarner_migrator:dentalwarner_migrator_local@localhost:55432/dentalwarner?schema=public"
POSTGRES_PORT="55432"
POSTGRES_APP_USER="dentalwarner_app"
POSTGRES_APP_PASSWORD="dentalwarner_app_local"
POSTGRES_MIGRATION_USER="dentalwarner_migrator"
POSTGRES_MIGRATION_PASSWORD="dentalwarner_migrator_local"
POSTGRES_POOL_MAX="10"
POSTGRES_POOL_IDLE_TIMEOUT_MS="30000"
POSTGRES_POOL_CONNECTION_TIMEOUT_MS="5000"
REDIS_URL="redis://localhost:6379"
REDIS_PORT="6379"
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
# Cookie-only refresh is the supported contract. Production rejects true.
AUTH_INCLUDE_REFRESH_TOKEN_IN_RESPONSE="false"
API_PORT="3001"
WEB_PORT="3000"
INVENTORY_PROVIDER="LOCAL_DATABASE"
VITE_API_URL="http://127.0.0.1:3001/api/v1"
NEXT_PUBLIC_API_URL="http://127.0.0.1:3001"
# Production must use explicit HTTPS origins separated by commas.
CORS_ORIGINS="http://localhost:3000"
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX="120"
LOGIN_RATE_LIMIT_EMAIL_MAX="10"
LOGIN_RATE_LIMIT_IP_MAX="100"
LOGIN_RATE_LIMIT_WINDOW_MS="900000"
PUBLIC_BOOKING_RATE_LIMIT_MAX="60"
# Comma-separated proxy IP allowlist. Never replace with a global trust-proxy=true setting.
TRUSTED_PROXY_IPS=""
# Required by GET /api/v1/metrics. Use a long random value and restrict network access too.
METRICS_BEARER_TOKEN="replace-with-a-long-random-secret"
SEED_ORGANIZATION_NAME="Dentalwarner Corporate"
SEED_ORGANIZATION_SLUG="dentalwarner"
SEED_DEFAULT_BRANCH_NAME="Sucursal Matriz"
SEED_DEFAULT_BRANCH_CODE="MATRIZ"
SEED_ADMIN_EMAIL="admin@dentalwarner.local"
SEED_ADMIN_PASSWORD="Admin123!"

# Transactional email. Use the SMTP credentials from Brevo, SendGrid, Resend, or another provider.
MAIL_ENABLED=false
MAIL_HOST="smtp.gmail.com"
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER="replace-with-smtp-user"
MAIL_PASSWORD="replace-with-smtp-password"
MAIL_FROM_ADDRESS="acceso@dentalsuite.com"
MAIL_FROM_NAME="DentalSuite"
MAIL_SUPPORT_ADDRESS="soporte@dentalsuite.com"
# Automatic appointment confirmations are opt-in. Enable only after SMTP has been verified.
APPOINTMENT_REMINDER_WORKER_ENABLED=false
APPOINTMENT_REMINDER_WORKER_INTERVAL_MS=60000
APPOINTMENT_REMINDER_PROVIDER_COOLDOWN_MS=900000
APPOINTMENT_REMINDER_LEASE_MS=120000
# Local development frontend. In production, set this to the public web domain.
FRONTEND_URL="http://localhost:3000"
INVITATION_TTL_MINUTES=1440

# Satisfaction survey worker and delivery webhooks.
SURVEY_WORKER_ENABLED=false
SURVEY_WORKER_INTERVAL_MS=10000
SURVEY_WORKER_LEASE_MS=120000
SURVEY_WEBHOOK_SECRET="replace-with-a-long-random-secret"

# Roll out versioned agreements independently from the legacy administrative agreement flow.
AGREEMENTS_V2_ENABLED=false
VITE_AGREEMENTS_V2_ENABLED=false
PRICE_LISTS_V2_ENABLED=false
VITE_PRICE_LISTS_V2_ENABLED=false

# Shared secret used only by the external WhatsApp booking bot.
BOOKING_BOT_API_KEY="replace-with-a-long-random-secret"
BOOKING_BOT_ORGANIZATION_ID="replace-with-organization-id"

# 32-byte key (64 hexadecimal characters or base64) used to encrypt consent signatures and PDFs at rest.
CONSENT_STORAGE_ENCRYPTION_KEY=""
CLINICAL_STORAGE_ENCRYPTION_KEY=""
OBJECT_STORAGE_PROVIDER="local"
LOCAL_OBJECT_STORAGE_ROOT=""
LEGACY_STORAGE_ROOT=""
MALWARE_SCANNER_PROVIDER="development"
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="true"
CLAMAV_HOST=""
CLAMAV_PORT="3310"
# 32-byte key (64 hexadecimal characters or base64) used to encrypt stored report exports.
REPORT_STORAGE_ENCRYPTION_KEY=""
REPORT_WORKER_LEASE_MS="600000"
MARKETING_RECIPIENT_LEASE_MS="120000"
# Independent 32-byte key used only for encrypted storage backup archives.
STORAGE_BACKUP_ENCRYPTION_KEY=""
STORAGE_BACKUP_SOURCE="apps/api/storage"
