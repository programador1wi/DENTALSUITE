model Branch {
  id                              String                          @id @default(cuid())
  organizationId                  String
  organization                    Organization                    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  brandId                         String?
  brand                           BranchBrand?                    @relation(fields: [brandId], references: [id], onDelete: SetNull)
  zoneId                          String?
  zone                            BranchZone?                     @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  name                            String
  description                     String?
  phone                           String?
  countryCode                     String?                         @default("+52")
  secondaryPhone                  String?
  email                           String?
  replyToEmail                    String?
  website                         String?
  address                         String?
  exteriorNumber                  String?
  interiorNumber                  String?
  neighborhood                    String?
  postalCode                      String?
  municipality                    String?
  references                      String?
  city                            String?
  state                           String?
  country                         String?                         @default("MX")
  timezone                        String?                         @default("America/Mexico_City")
  showInEmails                    Boolean                         @default(true)
  showInDocuments                 Boolean                         @default(true)
  showInOnlineScheduling          Boolean                         @default(true)
  allowOnlineAppointments         Boolean                         @default(true)
  allowNotifications              Boolean                         @default(true)
  /// Agenda configuration per branch (minutes per slot, visible start/end hours).
  /// Defaults match clinic operations (10:00-19:00 with 30 minute slots).
  agendaSlotMinutes               Int                             @default(30)
  agendaStartHour                 Int                             @default(10)
  agendaEndHour                   Int                             @default(19)
  isActive                        Boolean                         @default(true)
  code                            String?
  dentalinkPlatformCode           String?
  dentalinkSucursalId             Int?
  dentalinkSucursalName           String?
  status                          BranchStatus                    @default(ACTIVE)
  users                           UserBranch[]
  professionalBranches            ProfessionalBranch[]
  professionalContractBranches    ProfessionalContractBranch[]
  professionalBranchTransfers     ProfessionalBranchTransfer[]
  professionalSchedules           ProfessionalSchedule[]
  professionalSpecialSchedules    ProfessionalSpecialSchedule[]
  chairs                          Chair[]
  priceLists                      BranchPriceList[]
  treatmentPlans                  TreatmentPlan[]
  payments                        Payment[]
  expenses                        Expense[]
  payrollLiquidations             PayrollLiquidation[]
  cashRegisters                   CashRegister[]
  cashMovements                   CashMovement[]
  refunds                         Refund[]
  paymentSettlements              PaymentSettlement[]
  cashDiscountRuleBranches        CashDiscountRuleBranch[]
  cashDiscountApplications        CashDiscountApplication[]
  inventoryItems                  InventoryItem[]
  inventoryWarehouses             InventoryWarehouse[]
  inventoryMovements              InventoryMovement[]
  inventoryStockCounts            InventoryStockCount[]
  patients                        Patient[]
  patientTasks                    PatientTask[]
  crmTaskConfigurations           CrmTaskConfiguration[]
  appointments                    Appointment[]
  appointmentReprogrammingBatches AppointmentReprogrammingBatch[]
  appointmentReprogrammingCases   AppointmentReprogrammingCase[]
  auditLogs                       AuditLog[]
  consentTemplateScopes           ConsentTemplateBranch[]
  consents                        Consent[]
  familyGroups                    FamilyGroup[]
  familyPolicies                  FamilyPolicy[]
  familyPolicyPayments            FamilyPolicyPayment[]
  familyPolicyUsages              FamilyPolicyUsage[]
  createdAt                       DateTime                        @default(now())
  updatedAt                       DateTime                        @updatedAt
  deletedAt                       DateTime?
  createdById                     String?
  updatedById                     String?

  treatmentPlanReferrals            TreatmentPlanReferral[]
  clinicalEvolutions                ClinicalEvolution[]
  procedureEvolutionFieldTemplates  ProcedureEvolutionFieldTemplate[]
  procedureInventoryTemplates       ProcedureInventoryTemplate[]
  patientLedgerEntries              PatientLedgerEntry[]
  financialDocuments                FinancialDocument[]
  coverageCases                     CoverageCase[]
  patientBenefitCoverages           PatientBenefitCoverage[]
  patientBenefitCoverageValidations PatientBenefitCoverageValidation[]
  patientBenefitCoverageAudits      PatientBenefitCoverageAudit[]
  patientBenefitCoverageDocuments   PatientBenefitCoverageDocument[]
  agreementBranches                 AgreementBranch[]
  payrollDiscountPlans              PayrollDiscountPlan[]
  agreementCharges                  AgreementCharge[]
  companyPayments                   CompanyPayment[]
  marketingSegments                 MarketingSegment[]
  emailCampaigns                    EmailCampaign[]
  holidays                          Holiday[]

  @@unique([organizationId, code])
  @@unique([organizationId, dentalinkPlatformCode, dentalinkSucursalId])
  @@index([brandId])
  @@index([zoneId])
  @@index([organizationId, dentalinkPlatformCode])
  @@index([organizationId, isActive])
  @@index([organizationId, status])
}

